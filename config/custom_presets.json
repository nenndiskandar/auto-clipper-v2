{
  "hotThumbnail": {
    "label": "hotThumbnail",
    "desc": "Custom preset",
    "cfg": {
      "server_url": "http://localhost:20128/v1",
      "hf_system_message": "Kamu adalah asisten AI untuk menemukan highlight video. Tugasmu adalah memilih SEMUA momen terbaik dari transcript yang layak dijadikan klip viral — jumlahnya OTOMATIS (tentukan sendiri berdasarkan kualitas & panjang video, jangan memaksa jumlah tertentu).\n\nSYARAT:\n1. Durasi tiap klip antara 60 hingga 120 detik (hitung dari timestamp).\n2. Pilih momen yang menarik, lucu, atau memiliki statement penting.\n3. Format waktu: HH:MM:SS,mmm.\n\nOUTPUT HARUS BERUPA JSON ARRAY TANPA TEKS LAIN:\n[\n {\n  \"start_time\": \"00:01:10,000\",\n  \"end_time\": \"00:02:15,000\",\n  \"title\": \"Judul Klip Menarik\",\n  \"description\": \"Deskripsi singkat klip ini.\",\n  \"virality_score\": 8,\n  \"hook_text\": \"Kalimat pendek yang menarik\"\n }\n]\n\n====================\n{video_context}\n\nTranscript:\n{transcript}",
      "temperature": 0.7,
      "hf_model": "AUTO",
      "subtitle_language": "id",
      "fw_model": "small",
      "resolution": "1080p",
      "aspect_ratio": "9:16",
      "portrait_mode": "crop",
      "num_clips": 25,
      "use_gpu": false,
      "stabilize": false,
      "smooth_follow": false,
      "face_tracking_mode": "mediapipe",
      "pan_speed_limit": 1.5,
      "center_weight": 0.6,
      "switch_threshold": 0.35,
      "min_shot_duration": 30,
      "lip_activity": 0.05,
      "captions": true,
      "subtitle_style": "pop",
      "sync_offset": 0.5,
      "hook": true,
      "hook_style": {
        "box_mode": "half_screen",
        "font_size": 0.09,
        "corner_radius": 12,
        "bg_opacity": 90,
        "font_color": "#ffffff",
        "bg_color": "#ff3300",
        "glitch": true
      },
      "watermark_enabled": false,
      "watermark_x": 0.8,
      "watermark_y": 0.85,
      "watermark_scale": 0.15,
      "watermark_opacity": 0.8,
      "credit_watermark": false,
      "credit_watermark_x": 0.1,
      "credit_watermark_y": 0.1,
      "credit_watermark_size": 0.02,
      "credit_watermark_opacity": 0.7,
      "color_grade": "",
      "motion_blur": 0,
      "vignette": 0,
      "speed_ramp_start": 0,
      "speed_ramp_end": 0,
      "speed_factor": 1,
      "ducking_level_db": -12
    }
  },
